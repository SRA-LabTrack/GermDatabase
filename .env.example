# Safe browser configuration (also use these in Vercel)
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_FALLBACK_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_ENABLE_FALLBACK=false
VITE_APPWRITE_PROJECT_ID=6a744cda00030236187b
VITE_APPWRITE_DATABASE_ID=germdatabase
VITE_APPWRITE_MEDIA_BUCKET_ID=germ-media
# Optional: set this only if the admin API is hosted on a different domain.
# VITE_ADMIN_API_URL=https://germ-database.vercel.app/api/admin-accounts

# ONE-TIME SETUP ONLY. Do not commit this key.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a744cda00030236187b
APPWRITE_DATABASE_ID=germdatabase
APPWRITE_MEDIA_BUCKET_ID=germ-media
APPWRITE_API_KEY=PASTE_TEMPORARY_SETUP_KEY_HERE

# One-time administrator bootstrap. If this email already exists, no password is needed.
INITIAL_ADMIN_EMAIL=ncrowsboosting@gmail.com
INITIAL_ADMIN_USER_ID=6a7534ee0022112c4500
INITIAL_ADMIN_NAME=CaneSprout Administrator
# Only needed if setup must create the very first admin account:
INITIAL_ADMIN_PASSWORD=

# SERVER-ONLY ACCOUNT MANAGEMENT KEY.
# On Vercel, add APPWRITE_ADMIN_API_KEY as a secret Environment Variable.
# Give it only the Appwrite user-management scopes needed to list/create users and update labels.
# Never prefix this with VITE_ and never commit the real value.
APPWRITE_ADMIN_API_KEY=PASTE_LEAST_PRIVILEGE_SERVER_KEY_HERE
