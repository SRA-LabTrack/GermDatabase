{
  "name": "canesprout-registry",
  "private": true,
  "version": "2.13.76",
  "description": "Sugarcane Germplasm Resource Database unified web + Electron offline-first edition with red-font Origin/other attributes, A:CH Excel support, local desktop enrollment, persistent offline mutation queues, and paced Appwrite reconnect sync.",
  "main": "electron/main.cjs",
  "author": "SRA-LabTrack",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host localhost --port 5174",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host localhost --port 4174",
    "setup:appwrite": "node scripts/setup-appwrite.mjs",
    "desktop:dev": "concurrently -k \"node node_modules/vite/bin/vite.js --host localhost --port 5174\" \"wait-on http://localhost:5174 && cross-env GERM_DEV_URL=http://localhost:5174 electron .\"",
    "desktop:build": "npm run desktop:verify && npm run build && electron-builder",
    "desktop:build:win": "npm run desktop:verify && npm run build && electron-builder --win nsis --x64",
    "desktop:publish": "npm run desktop:verify && npm run build && electron-builder --win nsis --x64 --publish always",
    "grant:bootstrap-admin": "node --dns-result-order=ipv4first scripts/grant-bootstrap-admin.mjs",
    "migrate:admin-label": "node --dns-result-order=ipv4first scripts/grant-bootstrap-admin.mjs",
    "migrate:sra-hyv": "node --dns-result-order=ipv4first scripts/migrate-sra-hyv-characteristics.mjs",
    "audit:duplicates": "node --dns-result-order=ipv4first scripts/audit-duplicate-varieties.mjs",
    "dedupe:safe-migration-variants": "node --dns-result-order=ipv4first scripts/dedupe-safe-migration-variants.mjs",
    "audit:registry-full": "node --dns-result-order=ipv4first scripts/audit-registry-integrity.mjs",
    "repair:registry-safe": "node --dns-result-order=ipv4first scripts/repair-safe-registry-integrity.mjs",
    "repair:registry-safe-dedupe": "node --dns-result-order=ipv4first scripts/safe-dedupe-format-duplicates-v2.7.9.mjs",
    "setup:combinations": "node scripts/setup-combination-registry.mjs",
    "audit:combination-duplicates": "node scripts/audit-combination-duplicates.mjs",
    "cleanup:combination-duplicates": "node scripts/cleanup-combination-duplicates.mjs",
    "desktop:verify": "node scripts/verify-desktop-offline.mjs",
    "audit:variety-identities-local": "node scripts/audit-variety-identities-local.mjs",
    "audit:red-traits-local": "node scripts/audit-red-traits-local.mjs",
    "audit:source-match": "node scripts/audit-source-workbook-match.mjs",
    "audit:germplasm-counters": "node scripts/audit-germplasm-counters.mjs",
    "audit:pedigree-source": "node scripts/audit-pedigree-source.mjs",
    "verify:pedigree-web": "node scripts/verify-pedigree-web.mjs",
    "audit:preview-data-quality": "node scripts/audit-preview-data-quality.mjs",
    "verify:variety-map-web": "node scripts/verify-variety-map-web.mjs",
    "verify:variety-map-precision": "node scripts/verify-variety-map-precision.mjs",
    "verify:variety-map-performance": "node scripts/verify-variety-map-performance.mjs",
    "verify:variety-map-transition": "node scripts/verify-variety-map-transition.mjs",
    "verify:variety-map-profile-return": "node scripts/verify-variety-map-profile-return.mjs",
    "audit:variety-map-coverage": "node scripts/audit-variety-map-coverage.mjs",
    "verify:profile-trait-visuals": "node scripts/verify-profile-trait-visuals.mjs",
    "verify:profile-map-exact": "node scripts/verify-profile-map-exact-v2.13.40.mjs",
    "verify:origin-attribute-coordinates": "node scripts/verify-origin-attribute-coordinates-v2.13.41.mjs",
    "verify:profile-print": "node scripts/verify-profile-print-v2.13.42.mjs",
    "verify:profile-card-print": "node scripts/verify-profile-card-print-v2.13.43.mjs",
    "verify:profile-print-preview": "node scripts/verify-profile-pdf-quality-v2.13.46.mjs",
    "verify:profile-print-actions": "node scripts/verify-profile-pdf-quality-v2.13.46.mjs",
    "verify:profile-pdf-quality": "node scripts/verify-profile-pdf-quality-v2.13.46.mjs",
    "verify:profile-document-exports": "node scripts/verify-profile-document-exports-v2.13.47.mjs",
    "verify:profile-preview-actions": "node scripts/verify-profile-preview-actions-v2.13.49.mjs",
    "verify:pwa-install": "node scripts/verify-installable-pwa-v2.13.50.mjs",
    "verify:breeding-reports": "node scripts/verify-breeding-reports-v2.13.51.mjs",
    "verify:breeding-report-ranges": "node scripts/verify-breeding-report-ranges-v2.13.52.mjs",
    "verify:breeding-report-exports": "node scripts/verify-breeding-report-exports-v2.13.53.mjs",
    "verify:breeding-report-close": "node scripts/verify-breeding-report-close-v2.13.54.mjs",
    "verify:breeding-report-toolbar-offset": "node scripts/verify-breeding-report-toolbar-offset-v2.13.55.mjs",
    "verify:breeding-report-portal": "node scripts/verify-breeding-report-portal-v2.13.56.mjs",
    "verify:breeding-report-portal-position": "node scripts/verify-breeding-report-portal-position-v2.13.57.mjs",
    "verify:breeding-month-year": "node scripts/verify-breeding-month-year-v2.13.58.mjs",
    "verify:variety-map-smooth-redirect": "node scripts/verify-variety-map-smooth-redirect-v2.13.75.mjs",
    "verify:toolbar-cleanup": "node scripts/verify-toolbar-cleanup-v2.13.60.mjs",
    "verify:toolbar-menu-fix": "node scripts/verify-toolbar-menu-fix-v2.13.61.mjs",
    "verify:toolbar-tools-portal": "node scripts/verify-toolbar-tools-portal-v2.13.68.mjs",
    "verify:toolbar-equal-nav": "node scripts/verify-toolbar-equal-nav-v2.13.63.mjs",
    "verify:toolbar-stable": "node scripts/verify-toolbar-stable-v2.13.64.mjs",
    "verify:toolbar-classic-layout": "node scripts/verify-toolbar-classic-layout-v2.13.65.mjs",
    "verify:toolbar-reset": "node scripts/verify-toolbar-reset-v2.13.66.mjs",
    "verify:toolbar-final": "node scripts/verify-toolbar-final-v2.13.67.mjs",
    "verify:toolbar-isolated-nav": "node scripts/verify-toolbar-isolated-nav-v2.13.68.mjs",
    "verify:excel-tools-collapse": "node scripts/verify-excel-tools-collapse-v2.13.69.mjs",
    "verify:profile-card-print-menu": "node scripts/verify-profile-card-print-menu-v2.13.70.mjs",
    "verify:photo-first-browse": "node scripts/verify-photo-first-browse-v2.13.71.mjs",
    "verify:breeding-suggestions": "node scripts/verify-breeding-suggestions-v2.13.72.mjs",
    "verify:breeding-history-suggestions": "node scripts/verify-breeding-history-suggestions-v2.13.73.mjs",
    "verify:variety-map-first-redirect": "node scripts/verify-variety-map-first-redirect-v2.13.74.mjs",
    "verify:variety-map-build-repair": "node scripts/verify-variety-map-build-repair-v2.13.75.mjs",
    "verify:germplasm-pedigree-title": "node scripts/verify-germplasm-pedigree-title-v2.13.76.mjs"
  },
  "dependencies": {
    "appwrite": "^26.2.0",
    "electron-updater": "^6.6.2",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "node-appwrite": "^27.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "docx": "^9.7.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ph.sralabtrack.canesprout",
    "productName": "CaneSprout Registry",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CaneSprout-Registry-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CaneSprout Registry",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SRA-LabTrack",
        "repo": "GermDatabase",
        "releaseType": "release"
      }
    ],
    "artifactName": "CaneSprout-Registry-Setup-${version}.${ext}",
    "electronUpdaterCompatibility": ">=2.16"
  }
}
